<query id="insertIgnoredPackage" action="insert">
	<tables>
		<table name="autoinstall_ignore" />
	</tables>
	<columns>
		<column name="package_srl" var="package_srl" filter="number" notnull="notnull" />
		<column name="version" var="version" notnull="notnull" />
		<column name="regdate" var="regdate" default="datetime()" />
	</columns>
</query>
