<query id="getIgnoredPackages" action="select">
    <tables>
        <table name="autoinstall_ignore" />
    </tables>
    <columns>
        <column name="*" />
    </columns>
    <conditions>
        <condition operation="equal" column="package_srl" var="package_srl" filter="number" />
    </conditions>
</query>
