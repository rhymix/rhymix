<query id="countAuthLog" action="select">
	<tables>
		<table name="member_auth_log" />
	</tables>
	<columns>
		<column name="count(*)" alias="count" />
		<column name="max(regdate)" alias="last_update" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" />
		<condition operation="equal" column="action_type" var="action_type" />
		<condition operation="more" column="regdate" var="regdate_after" />
		<condition operation="less" column="regdate" var="regdate_before" />
		<condition operation="equal" column="ipaddress" var="ipaddress" />
	</conditions>
</query>
