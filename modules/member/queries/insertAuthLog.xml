<query id="insertAuthLog" action="insert">
	<tables>
		<table name="member_auth_log" />
	</tables>
	<columns>
		<column name="member_srl" var="member_srl" filter="number" notnull="notnull" />
		<column name="action_type" var="action_type" notnull="notnull" />
		<column name="action_data" var="action_data" />
		<column name="email_address" var="email_address" />
		<column name="phone_number" var="phone_number" />
		<column name="regdate" var="regdate" default="datetime()" />
		<column name="ipaddress" var="ipaddress" default="ipaddress()" />
	</columns>
</query>
