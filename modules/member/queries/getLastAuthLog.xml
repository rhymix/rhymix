<query id="getLastAuthLog" action="select">
	<tables>
		<table name="member_auth_log" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" />
		<condition operation="equal" column="action_type" var="action_type" />
		<condition operation="in" column="action_type" var="action_types" />
		<condition operation="equal" column="ipaddress" var="ipaddress" />
	</conditions>
	<navigation>
		<index var="sort_index" default="id" order="desc" />
		<list_count var="list_count" default="1" />
	</navigation>
</query>
